{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "extends": "eslint:recommended",
  "globals": {
    "NH": "writable",
    "ResizeObserver": "readonly"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-inner-declarations": "off",
    "no-empty": "off"
  }
}
